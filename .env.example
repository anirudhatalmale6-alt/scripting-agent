# =============================================================================
# AI Scripting Agent — Configuration
# Fill in OPENAI_API_KEY, then run: docker-compose up --build
# =============================================================================


# =============================================================================
# SCRIPT GENERATION FLAGS
# Turn on/off generation of each script type
# =============================================================================
ENABLE_K6=true
ENABLE_SELENIUM=true
ENABLE_LOADRUNNER=true
ENABLE_PLAYWRIGHT=true


# =============================================================================
# LLM PROVIDER — switch between local Ollama and cloud OpenAI
# =============================================================================
LLM_PROVIDER=ollama                    # "ollama" (local, free) or "openai" (cloud)

# Ollama settings (when LLM_PROVIDER=ollama)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# OpenAI settings (when LLM_PROVIDER=openai)
OPENAI_API_KEY=                        # [FILL IN] sk-...
OPENAI_MODEL=gpt-4o-mini               # or gpt-4o for better quality

ENABLE_AI=true                         # false = use templates only, no AI calls

# PII SANITIZATION — redact sensitive data before sending to LLM
SANITIZATION_ENABLED=true
SANITIZATION_CONFIG_PATH=config/sanitization_rules.yaml


# =============================================================================
# LOCAL MODE — scan a local source code directory (no GitHub needed)
# =============================================================================
LOCAL_REPO_PATH=../testrepo            # Path to source code directory
                                       # Docker: mounted as /app/target-repo
                                       # Local:  absolute or relative path

REPO_NAME=local-repo                   # Name for organizing generated scripts
                                       # Scripts go in: scripts/<repo_name>/dev/

# Target app URL (where the app under test is running)
# Docker:    http://host.docker.internal:8000  (reach host from container)
# Local run: http://localhost:8000
SFCC_SITE_URL=http://host.docker.internal:8000
ENV=dev                                # dev | stage | prod


# =============================================================================
# GITHUB MODE (optional — leave all empty for local-only mode)
# Only needed if you want GitHub webhook integration
# =============================================================================
GITHUB_TOKEN=                          # github_pat_...
TOKEN=                                 # same value as GITHUB_TOKEN
GITHUB_REPOS=                          # comma-separated: org/repo1,org/repo2
GITHUB_REPO_URL=                       # https://api.github.com/repos/owner/repo


# =============================================================================
# SANDBOX — run tests safely
# =============================================================================
USE_SANDBOX=false                      # true = run tests in Docker containers
                                       # false = run directly (needs k6/mvn)

CHECKPOINT_DIR=./checkpoints
AUTO_TEST_ON_STARTUP=false             # true = run tests after generation


# =============================================================================
# SELF-HEAL — scheduled script health check
# =============================================================================
SELF_HEAL_INTERVAL_MINUTES=60          # how often to check and fix failing scripts


# =============================================================================
# NOTIFICATIONS (optional)
# =============================================================================
SLACK_WEBHOOK=                         # https://hooks.slack.com/services/...


# =============================================================================
# INTEGRATIONS (optional — leave empty to skip gracefully)
# =============================================================================
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

DATADOG_API_KEY=
SPEEDCURVE_API_KEY=
SPEEDCURVE_SITE_ID=


# =============================================================================
# K6 LOAD SETTINGS
# =============================================================================
K6_VUS=10                              # virtual users for load test
K6_DURATION=30s                        # duration of each k6 run
K6_SCRIPT=script.js
