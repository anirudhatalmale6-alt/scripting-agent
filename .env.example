# =============================================================================
# AI Performance Agent — Configuration
# All features are configurable from this file.
# =============================================================================


# =============================================================================
# SCRIPT GENERATION FLAGS
# Turn on/off generation of each script type
# =============================================================================
ENABLE_K6=true
ENABLE_SELENIUM=true
ENABLE_LOADRUNNER=true


# =============================================================================
# AI SETTINGS
# =============================================================================
OPENAI_API_KEY=                        # [FILL IN] sk-...
OPENAI_MODEL=gpt-4o-mini               # or gpt-4o for better quality
ENABLE_AI=true                         # false = use templates only, no AI calls


# =============================================================================
# TARGET APPLICATION
# URL of the app being tested
# Docker:    http://api:8000  (service name inside docker network)
# Local run: http://localhost:8000
# =============================================================================
SFCC_SITE_URL=http://localhost:8000
ENV=dev                                # dev | stage | prod


# =============================================================================
# GITHUB — repo monitoring + webhook detection
# =============================================================================
GITHUB_TOKEN=                          # [FILL IN] github_pat_...

# Single repo (simple setup)
GITHUB_REPO=owner/repo

# Multi-repo (comma-separated — overrides GITHUB_REPO if set)
# Each repo gets its own isolated scripts/ subfolder
# Example: GITHUB_REPOS=org/frontend,org/backend,org/api
GITHUB_REPOS=owner/repo

GITHUB_REPO_URL=https://api.github.com/repos/owner/repo


# =============================================================================
# SANDBOX — Docker containers for running tests safely
# =============================================================================
USE_SANDBOX=true                       # true = run tests in Docker containers
                                       # false = run directly on host (needs k6/mvn installed)

AUTO_TEST_ON_STARTUP=false             # true = run sandbox tests after first-boot generation
                                       # false = faster startup, test manually via POST /run-tests


# =============================================================================
# SELF-HEAL — scheduled script health check
# =============================================================================
SELF_HEAL_INTERVAL_MINUTES=60          # how often to check and fix failing scripts


# =============================================================================
# MCP SERVER
# =============================================================================
MCP_URL=http://mcp-server:5002         # Docker: http://mcp-server:5002
                                       # Local:  http://localhost:5002


# =============================================================================
# NOTIFICATIONS
# =============================================================================
SLACK_WEBHOOK=                         # [FILL IN] https://hooks.slack.com/services/...
SMTP_SERVER=
SMTP_USER=
SMTP_PASS=
EMAIL_TO=


# =============================================================================
# INTEGRATIONS (optional — leave empty to skip gracefully)
# =============================================================================
JIRA_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=

DATADOG_API_KEY=
SPEEDCURVE_API_KEY=
SPEEDCURVE_SITE_ID=

GRAFANA_URL=
GRAFANA_API_KEY=
GRAFANA_USERNAME=
GRAFANA_RW_URL=
K6_PROMETHEUS_RW_SERVER_URL=
K6_PROMETHEUS_RW_USERNAME=
K6_PROMETHEUS_RW_PASSWORD=


# =============================================================================
# K6 LOAD SETTINGS
# =============================================================================
K6_VUS=10                              # virtual users for load test
K6_DURATION=30s                        # duration of each k6 run
K6_SCRIPT=script.js
